# ================================================================
# CloudPulse Frontend Production Environment Configuration Template
# ================================================================

# Base URL of the CloudPulse Express Backend API
# In production, set to your deployed backend URL (e.g., https://your-cloudpulse-api.onrender.com)
VITE_API_BASE_URL=http://localhost:5000

# WARNING: NEVER add JWT_SECRET, ENCRYPTION_KEY, SMTP_PASS, or Azure Client Secrets to this file!
# All Vite variables starting with VITE_ are embedded into the client browser bundle.
